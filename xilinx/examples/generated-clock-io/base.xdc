set_property -dict {PACKAGE_PIN W19 IOSTANDARD LVCMOS33} [get_ports clk_i]
set_property -dict {PACKAGE_PIN N15 IOSTANDARD LVCMOS33} [get_ports btn]
set_property -dict {PACKAGE_PIN Y19 IOSTANDARD LVCMOS33} [get_ports sd_clk]
set_property -dict {PACKAGE_PIN V20 IOSTANDARD LVCMOS33} [get_ports sd_di]
set_property -dict {PACKAGE_PIN Y18 IOSTANDARD LVCMOS33} [get_ports sd_do]
set_property -dict {PACKAGE_PIN U20 IOSTANDARD LVCMOS33} [get_ports dout]
set_property -dict {PACKAGE_PIN M13 IOSTANDARD LVCMOS33} [get_ports din_a]
set_property -dict {PACKAGE_PIN K13 IOSTANDARD LVCMOS33} [get_ports din_b]
set_property -dict {PACKAGE_PIN P19 IOSTANDARD LVCMOS33} [get_ports {led[0]}]
set_property -dict {PACKAGE_PIN P20 IOSTANDARD LVCMOS33} [get_ports {led[1]}]
